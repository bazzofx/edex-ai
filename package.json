{
  "name": "edex-ai",
  "productName": "eDEX AI",
  "version": "0.1.0",
  "private": true,
  "description": "eDEX-UI fork with an embedded browser and a voice-controlled assistant (proof of concept).",
  "keywords": [
    "desktop",
    "sci-fi",
    "terminal",
    "voice",
    "assistant"
  ],
  "main": "src/_boot.js",
  "scripts": {
    "setup": "npm install && cd src && npm install",
    "rebuild": "electron-rebuild -f -w node-pty -m src",
    "start": "electron src --nointro --dev",
    "start:intro": "electron src --dev",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "smoke": "node tests/smoke/launch.mjs",
    "pick-models": "node scripts/pick-models.mjs",
    "bench": "node scripts/bench.mjs",
    "prebuild-windows": "node -e \"require('fs').cpSync('src','prebuild-src',{recursive:true,filter:s=>!s.includes('node_modules')})\" && node prebuild-minify.js && cd prebuild-src && npm install --omit=dev",
    "build-windows": "electron-builder build -w",
    "postbuild-windows": "node -e \"require('fs').rmSync('prebuild-src',{recursive:true,force:true})\"",
    "init-file-icons": "git submodule update --init",
    "update-file-icons": "git submodule foreach git pull origin master && node file-icons-generator.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitSquared/edex-ui.git"
  },
  "author": "Gabriel 'Squared' SAILLARD <gabriel@saillard.dev> (https://gaby.dev) — eDEX AI fork contributors",
  "license": "GPL-3.0",
  "build": {
    "appId": "com.edexai.poc",
    "productName": "eDEX AI",
    "publish": null,
    "asar": true,
    "compression": "normal",
    "copyright": "Copyright © 2017-2021 Gabriel 'Squared' SAILLARD; eDEX AI changes GPL-3.0",
    "directories": {
      "output": "dist",
      "app": "prebuild-src"
    },
    "forceCodeSigning": false,
    "npmRebuild": true,
    "artifactName": "eDEX-AI-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "media/icon.ico"
    },
    "nsis": {
      "artifactName": "eDEX-AI-Windows-${arch}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "clean-css": "5.2.1",
    "electron": "45.3.0",
    "electron-builder": "26.18.1",
    "mime-types": "^2.1.33",
    "node-json-minify": "1.0.0",
    "terser": "^5.9.0"
  },
  "optionalDependencies": {
    "cson-parser": "4.0.9"
  }
}
