{
    "provider": "openrouter",
    "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKeyEnv": "apiOpenRouterEDEXAI",
        "model": "nvidia/nemotron-3.5-lightning:free",
        "fallbackModels": [
            "nvidia/nemotron-3.5-super-vl:free",
            "google/gemma-4-31b-it:free"
        ],
        "timeoutMs": 45000
    },
    "ollama": {
        "host": "http://127.0.0.1:11434",
        "model": "gemma4:latest",
        "timeoutMs": 90000
    },
    "assistant": {
        "maxToolRounds": 4,
        "toolTimeoutMs": 12000,
        "historyTurns": 6,
        "speakTypedReplies": false,
        "keepHistory": false,
        "confirmTimeoutMs": 60000
    },
    "searchProvider": "duckduckgo",
    "voice": {
        "enabled": true,
        "python": "python",
        "pttKey": "F8",
        "whisperModel": "base",
        "whisperDevice": "cpu",
        "whisperComputeType": "int8",
        "language": "en",
        "piperVoice": "",
        "inputDevice": null,
        "outputDevice": null
    }
}
